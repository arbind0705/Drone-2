<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_sensor_demo'>

    <!-- ================================================= -->
    <!-- PX4 X500 -->
    <!-- ================================================= -->

    <include merge='true'>
      <uri>model://x500</uri>
    </include>


    <!-- ================================================= -->
    <!-- RGB CAMERA -->
    <!-- ================================================= -->

    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose relative_to="base_link">0.12 0.03 0.242 0 0 0</pose>
    </include>

    <joint name="rgb_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">
        0.12 0.03 0.242 0 0 0
      </pose>
    </joint>


    <!-- ================================================= -->
    <!-- LiDAR 1 - FRONT -->
    <!-- ================================================= -->

    <link name="lidar_front_link">
      <pose relative_to="base_link">0.30 0 0.10 0 0 0</pose>

      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="lidar_front" type="gpu_lidar">
        <gz_frame_id>lidar_front_link</gz_frame_id>

        <update_rate>20</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="lidar_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_front_link</child>
    </joint>


    <!-- ================================================= -->
    <!-- LiDAR 2 - RIGHT -->
    <!-- ================================================= -->

    <link name="lidar_right_link">
      <pose relative_to="base_link">0 -0.30 0.10 0 0 -1.5708</pose>

      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="lidar_right" type="gpu_lidar">
        <gz_frame_id>lidar_right_link</gz_frame_id>

        <update_rate>20</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="lidar_right_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_right_link</child>
    </joint>


    <!-- ================================================= -->
    <!-- LiDAR 3 - REAR -->
    <!-- ================================================= -->

    <link name="lidar_rear_link">
      <pose relative_to="base_link">-0.30 0 0.10 0 0 3.14159</pose>

      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="lidar_rear" type="gpu_lidar">
        <gz_frame_id>lidar_rear_link</gz_frame_id>

        <update_rate>20</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="lidar_rear_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_rear_link</child>
    </joint>


    <!-- ================================================= -->
    <!-- LiDAR 4 - LEFT -->
    <!-- ================================================= -->

    <link name="lidar_left_link">
      <pose relative_to="base_link">0 0.30 0.10 0 0 1.5708</pose>

      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="lidar_left" type="gpu_lidar">
        <gz_frame_id>lidar_left_link</gz_frame_id>

        <update_rate>20</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="lidar_left_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_left_link</child>
    </joint>


    <!-- ================================================= -->
    <!-- LiDAR 5 - DOWNWARD -->
    <!-- ================================================= -->

    <link name="lidar_down_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.5708 0</pose>

      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="lidar_down" type="gpu_lidar">
        <gz_frame_id>lidar_down_link</gz_frame_id>

        <update_rate>20</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="lidar_down_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_down_link</child>
    </joint>

  </model>
</sdf>
